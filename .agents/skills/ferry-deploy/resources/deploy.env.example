# Non-secret settings. No quotes or shell expansions.
CONTROL_SSH=admin@control.example.internal
KUBECONFIG_PATH=/etc/kubernetes/admin.conf
NAMESPACE=ferry
RELEASE=ferry
REGISTRY_PUSH=registry.example.internal:5000
REGISTRY_INSECURE=false
IMAGE_PULL_REPOSITORY=localhost:5000/ferry/ferry
# IMAGE_PUSH_PATH=ferry/ferry
# BASE_PUSH_PATH=ferry/base
# Pod selection uses nodeSelector in values.yaml.
# HELM_TIMEOUT=5m
