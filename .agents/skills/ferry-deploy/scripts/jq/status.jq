"release: \(.status.info.status) revision: \(.status.version)", "image.digest: \(.values.image.digest)", "image.version: \(.values.image.version)", (.pods.items[] | "pod: \(.metadata.name) uid: \(.metadata.uid) phase: \(.status.phase) readiness: \([.status.conditions[]? | select(.type == "Ready") | .status][0] // "Unknown") restarts: \([.status.containerStatuses[]?.restartCount] | add // 0) node: \(.spec.nodeName)")
